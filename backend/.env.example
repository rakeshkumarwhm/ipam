# Copy to /etc/ipam/ipam.env (chmod 600, owner ipam). Never commit real values.
IPAM_DB_HOST=127.0.0.1
IPAM_DB_NAME=ipam
IPAM_DB_USER=ipam
IPAM_DB_PASSWORD=CHANGE_ME
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
IPAM_SECRET_KEY=
IPAM_ACCESS_TOKEN_MINUTES=15

# Optional Active Directory / LDAP (use ldaps:// so credentials are encrypted)
#IPAM_LDAP_URL=ldaps://dc1.example.com:636
#IPAM_LDAP_BASE_DN=DC=example,DC=com
#IPAM_LDAP_BIND_DN=CN=svc-ipam,OU=Service,DC=example,DC=com
#IPAM_LDAP_BIND_PASSWORD=
#IPAM_LDAP_ADMIN_GROUP_DN=CN=IPAM-Admins,OU=Groups,DC=example,DC=com
